// Place your key bindings in this file to override the defaults
[
  // bun -> install
  {
    "command": "runCommands",
    "key": "cmd+b cmd+i",
    "args": {
      "commands": [
        {
          "command": "workbench.action.terminal.sendSequence",
          "args": {
            "text": "bun install\u000D"
          }
        },
        // focus on the terminal
        "workbench.action.terminal.focus"
      ]
    }
  },
  // bun -> run -> file
  {
    "command": "runCommands",
    "key": "cmd+b cmd+r cmd+f",
    "args": {
      "commands": [
        {
          "command": "workbench.action.terminal.sendSequence",
          "args": {
            "text": "bun run ${fileDirname}/${fileBasename}\u000D"
          }
        },
        "workbench.action.terminal.focus"
      ]
    }
  },
  // bun -> run --hot -> file
  {
    "command": "runCommands",
    "key": "cmd+b cmd+r cmd+h cmd+f",
    "args": {
      // run the command "bun run <file>"
      "commands": [
        {
          "command": "workbench.action.terminal.sendSequence",
          "args": {
            "text": "bun run --hot ${fileDirname}/${fileBasename}\u000D"
          }
        },
        // focus on the terminal
        "workbench.action.terminal.focus"
      ]
    }
  },
  // bun debug file in debug console
  {
    "command": "runCommands",
    "key": "cmd+shift+b cmd+shift+r cmd+shift+f",
    "args": {
      "commands": ["extension.bun.debugFile", "workbench.debug.action.focusRepl"]
    }
  },
  // bun -> run -> dev
  {
    "command": "runCommands",
    "key": "cmd+b cmd+r cmd+d",
    "args": {
      // run the command "bun run dev"
      "commands": [
        {
          "command": "workbench.action.terminal.sendSequence",
          "args": {
            "text": "bun run dev\u000D"
          }
        },
        // focus on the terminal
        "workbench.action.terminal.focus"
      ]
    }
  },
  // bun -> run --hot -> dev
  {
    "command": "runCommands",
    "key": "cmd+b cmd+r cmd+h cmd+d",
    "args": {
      // run the command "bun run dev"
      "commands": [
        {
          "command": "workbench.action.terminal.sendSequence",
          "args": {
            "text": "bun run --hot dev\u000D"
          }
        },
        // focus on the terminal
        "workbench.action.terminal.focus"
      ]
    }
  },
  // bun -> run -> build
  {
    "command": "runCommands",
    "key": "cmd+b cmd+r cmd+b",
    "args": {
      "commands": [
        {
          "command": "workbench.action.terminal.sendSequence",
          "args": {
            "text": "bun run build\u000D"
          }
        },
        // focus on the terminal
        "workbench.action.terminal.focus"
      ]
    }
  },
  // bun -> run -> start
  {
    "command": "runCommands",
    "key": "cmd+b cmd+r cmd+s",
    "args": {
      "commands": [
        {
          "command": "workbench.action.terminal.sendSequence",
          "args": {
            "text": "bun run start\u000D"
          }
        },
        // focus on the terminal
        "workbench.action.terminal.focus"
      ]
    }
  },
  // rm -rf node_modules .next
  {
    "command": "runCommands",
    "key": "cmd+r cmd+m cmd+n",
    "args": {
      "commands": [
        {
          "command": "workbench.action.terminal.sendSequence",
          "args": {
            "text": "rm -rf node_modules .next\u000D"
          }
        },
        // focus on the terminal
        "workbench.action.terminal.focus"
      ]
    }
  },
  // git -> add all
  {
    "command": "runCommands",
    "key": "cmd+g cmd+a",
    "args": {
      "commands": [
        {
          "command": "workbench.action.terminal.sendSequence",
          "args": {
            "text": "git add .\u000D"
          }
        },
        // focus on the terminal
        "workbench.action.terminal.focus"
      ]
    }
  },
  // git -> add . && git commit with message (focus on terminal so user can input message
  {
    "command": "runCommands",
    "key": "cmd+g cmd+c",
    "args": {
      "commands": [
        {
          "command": "workbench.action.terminal.sendSequence",
          "args": {
            "text": "git add . && git commit -m \""
          }
        },
        // focus on the terminal
        "workbench.action.terminal.focus"
      ]
    }
  },
  // git -> push
  {
    "command": "runCommands",
    "key": "cmd+g cmd+p",
    "args": {
      "commands": [
        {
          "command": "workbench.action.terminal.sendSequence",
          "args": {
            "text": "git push\u000D"
          }
        },
        // focus on the terminal
        "workbench.action.terminal.focus"
      ]
    }
  },
  // git -> fetch and pull
  {
    "command": "runCommands",
    "key": "cmd+g cmd+f",
    "args": {
      "commands": [
        {
          "command": "workbench.action.terminal.sendSequence",
          "args": {
            "text": "git fetch && git pull\u000D"
          }
        },
        // focus on the terminal
        "workbench.action.terminal.focus"
      ]
    }
  },
  // git -> yolo commit
  {
    "command": "runCommands",
    "key": "cmd+g cmd+y",
    "args": {
      "commands": [
        {
          "command": "workbench.action.terminal.sendSequence",
          "args": {
            "text": "git add . && git commit -m \"yolo commit\" && git push\u000D"
          }
        },
        // focus on the terminal
        "workbench.action.terminal.focus"
      ]
    }
  },
  // run debugger and focus on the debug console
  {
    "command": "runCommands",
    "key": "cmd+shift+d",
    "args": {
      "commands": ["workbench.view.debug", "workbench.action.debug.start", "workbench.debug.action.focusRepl"]
    }
  },
  // terminal / debug window
  {
    "key": "ctrl+shift+t",
    "command": "workbench.action.terminal.focus"
  },
  {
    "key": "ctrl+shift+d",
    "command": "workbench.debug.action.focusRepl"
  },
  {
    "key": "alt+shift+b",
    "command": "workbench.action.tasks.runTask",
    "args": "bun biome check"
  },
  {
    "key": "ctrl+cmd+f",
